# Configuración de MongoDB
MONGO_URI=mongodb+srv://tu_usuario:tu_password@tu_cluster.mongodb.net/?appName=tu_app

# Puerto del servidor
PORT=4000

# JWT Secret para tokens (genera uno aleatorio con el comando abajo)
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=genera_un_secreto_aleatorio_largo_y_seguro_aqui

# Session Secret para express-session (genera uno aleatorio)
SESSION_SECRET=genera_otro_secreto_aleatorio_diferente_aqui

# Google OAuth Configuration
# Obtén estas credenciales en: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=tu_google_client_id_aqui
GOOGLE_CLIENT_SECRET=tu_google_client_secret_aqui
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Frontend URL (para redirección después de autenticación)
FRONTEND_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000

# Configuración SMTP para envío de correos (Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=tu_email@gmail.com
EMAIL_PASS=tu_app_password_de_gmail

# INSTRUCCIONES:
# 1. Copia este archivo a .env: cp .env.example .env
# 2. Completa todas las variables con tus credenciales reales
# 3. NUNCA compartas tu archivo .env con nadie
# 4. El archivo .env está protegido por .gitignore y NO se subirá a git
